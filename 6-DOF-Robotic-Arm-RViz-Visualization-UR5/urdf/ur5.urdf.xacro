<?xml version="1.0"?>
<robot name="ur5_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gray"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.8 1.0"/></material>
  <material name="green"><color rgba="0.3 0.7 0.3 1.0"/></material>
  <material name="yellow"><color rgba="0.9 0.9 0.2 1.0"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
  <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
  <material name="purple"><color rgba="0.6 0.2 0.8 1.0"/></material>

  <link name="base_footprint">
    <visual><geometry><box size="0.001 0.001 0.001"/></geometry></visual>
  </link>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/base.dae"/></geometry>
      <material name="gray"/>
    </visual>
    <collision><geometry><cylinder radius="0.1" length="0.14"/></geometry></collision>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/shoulder.dae"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><cylinder radius="0.06" length="0.12"/></geometry></collision>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.089" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="3.15"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/upperarm.dae"/></geometry>
      <material name="green"/>
    </visual>
    <collision><geometry><cylinder radius="0.05" length="0.425"/></geometry></collision>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0.13585 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="3.15"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/forearm.dae"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision><geometry><cylinder radius="0.04" length="0.392"/></geometry></collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 -0.1197 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="3.15"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/wrist1.dae"/></geometry>
      <material name="red"/>
    </visual>
    <collision><geometry><cylinder radius="0.035" length="0.09465"/></geometry></collision>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0 0 0.39225" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="28.0" velocity="3.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/wrist2.dae"/></geometry>
      <material name="orange"/>
    </visual>
    <collision><geometry><cylinder radius="0.03" length="0.0823"/></geometry></collision>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0.093 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="28.0" velocity="3.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <geometry><mesh filename="package://ur5_6dof_description/meshes/wrist3.dae"/></geometry>
      <material name="purple"/>
    </visual>
    <collision><geometry><cylinder radius="0.025" length="0.06"/></geometry></collision>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin xyz="0 0 0.09465" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="28.0" velocity="3.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="ee_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="wrist_3_to_ee" type="fixed">
    <parent link="wrist_3_link"/><child link="ee_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>
