<?xml version="1.0"?>
<robot name="ur5_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_dummy_link"/>

  <!-- BASE -->
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/base.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/base.dae"/></geometry></collision>
  </link>

  <!-- SHOULDER -->
  <link name="shoulder_link">
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/shoulder.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/shoulder.dae"/></geometry></collision>
  </link>

  <!-- UPPER ARM -->
  <link name="upper_arm_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/upperarm.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/upperarm.dae"/></geometry></collision>
  </link>

  <!-- FOREARM -->
  <link name="forearm_link">
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/forearm.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/forearm.dae"/></geometry></collision>
  </link>

  <!-- WRIST 1 -->
  <link name="wrist1_link">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/wrist1.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/wrist1.dae"/></geometry></collision>
  </link>

  <!-- WRIST 2 -->
  <link name="wrist2_link">
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/wrist2.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/wrist2.dae"/></geometry></collision>
  </link>

  <!-- WRIST 3 -->
  <link name="wrist3_link">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/wrist3.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://ur5_6dof_gazebo/meshes/wrist3.dae"/></geometry></collision>
  </link>

  <!-- ================= JOINTS ================= -->
  <joint name="dummy_base_joint" type="fixed">
    <parent link="base_dummy_link"/>
    <child link="base_link"/>
  </joint>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.089"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="1"/>
  </joint>

  <joint name="upper_arm_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="1"/>
  </joint>

  <joint name="forearm_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="1"/>
  </joint>

  <joint name="wrist1_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist1_link"/>
    <origin xyz="0 0 0.2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="1"/>
  </joint>

  <joint name="wrist2_joint" type="revolute">
    <parent link="wrist1_link"/><child link="wrist2_link"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="1"/>
  </joint>

  <joint name="wrist3_joint" type="revolute">
    <parent link="wrist2_link"/><child link="wrist3_link"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="1"/>
  </joint>

  <!-- ================= Transmissions ================= -->
  <transmission name="t_shoulder">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="shoulder_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor_shoulder">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="t_upper_arm">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="upper_arm_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor_upper">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="t_forearm">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="forearm_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor_forearm">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="t_wrist1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist1_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor_w1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="t_wrist2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist2_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor_w2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="t_wrist3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wrist3_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
    <actuator name="motor_w3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ================= Gazebo ROS Control Plugin ================= -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so"/>
  </gazebo>
</robot>
